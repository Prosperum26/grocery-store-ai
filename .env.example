PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# API Keys (dien khi code nhanh RAG / Copilot)
GEMINI_API_KEY=

# ai_db (Postgres + pgvector chay bang docker compose, xem docker-compose.yml)
AI_DB_NAME=ai_db
AI_DB_USER=ai_user
AI_DB_PASSWORD=
AI_DB_HOST=127.0.0.1
AI_DB_PORT=5434

# Lop loi AI (GD 4). Khoa chi dat o day, khong commit .env
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-flash-latest
CLAUDE_MODEL=claude-haiku-5-5
AI_GEMINI_ENABLED=true
AI_CLAUDE_ENABLED=false
